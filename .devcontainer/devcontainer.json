{
  "name": "Mobile Dev Tools Community",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "postCreateCommand": "npm ci",
  "forwardPorts": [5173],
  "portsAttributes": { "5173": { "label": "Workspace preview", "onAutoForward": "notify" } },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.wordWrap": "on",
        "editor.fontSize": 16,
        "terminal.integrated.fontSize": 16,
        "editor.minimap.enabled": false,
        "breadcrumbs.enabled": false
      }
    }
  }
}
